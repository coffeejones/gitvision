# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real tokens.

# GitHub API token. Without one, the unauthenticated rate limit (60
# req/hr) makes most analyses fail. With one, you get 5000 req/hr.
# Generate at https://github.com/settings/tokens/new — tick `public_repo`
# scope only. Read-only is plenty.
GITHUB_TOKEN=

# Optional — enables the AI summary + AI health verdict panels.
# Get a key at https://console.anthropic.com/settings/keys
# Leave empty to disable AI features (the panels just hide themselves
# gracefully — every other tab still works).
ANTHROPIC_API_KEY=

# Optional — daily kill-switch on Anthropic API calls (v0.36+).
# Resets at UTC midnight. Default 100 if unset. Set to 0 as a panic
# switch (disables AI globally). Useful when running publicly to bound
# the worst-case Anthropic bill.
# AI_DAILY_BUDGET=100

# Optional — Plausible analytics domain (v0.41+). When set, the
# Plausible script loads on every page; cookie-free, IP-anonymized.
# Unset → no analytics, no script tag, no tracking.
# Set to your Plausible domain (e.g. codetrawl.com) — this must match
# the domain you registered in your Plausible dashboard.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Optional — feedback URL for the footer "Feedback" link (v0.41+).
# Point to a Tally / Cal.com / Typeform URL. Falls back to the GitHub
# Issues page when unset.
# NEXT_PUBLIC_FEEDBACK_URL=

# Optional — persistent volume directory on Railway. Sessions and
# job-status files live under <DATA_DIR>/sessions and <DATA_DIR>/jobs.
# Default: .gitvision/ in the project root (good for local dev).
# REPOBARON_DATA_DIR=/data

# --- GitHub App (PR-bot) ---
# These are only required if you're running the GitHub App webhook
# receiver. The web UI works fine without them. See
# eval/strategy/github-app-skeleton-2026-05.md for the full design.
#
# App ID from https://github.com/settings/apps/<your-app>
# GITHUB_APP_ID=
#
# RSA private key for signing JWTs to GitHub. Base64-encode the PEM
# blob so it fits in a single env var without multi-line escaping:
#   base64 -i path/to/private-key.pem | pbcopy
# Then decode at runtime in lib/githubApp/auth.ts.
# GITHUB_APP_PRIVATE_KEY=
#
# Webhook secret — strong random string set when registering the app.
# Used by /api/github/webhook to verify HMAC-SHA256 signatures.
# Required for the webhook receiver to accept any request (returns 503
# otherwise).
# GITHUB_APP_WEBHOOK_SECRET=
#
# OAuth client ID (only needed for install-redirect URL in Commit 8+).
# GITHUB_APP_CLIENT_ID=
#
# Public base URL of the CodeTrawl workspace — used to build the
# "Full analysis ↗" link in PR comments. No trailing slash.
# Production: https://codetrawl.com
# Local dev: defaults to http://localhost:3000 when unset.
# REPOBARON_PUBLIC_URL=

# --- Better Auth (v0.75 / OAuth platform) ---
# These power the login system on codetrawl.com itself (separate from
# the GitHub App PR-bot above — that's a different OAuth identity).
#
# Server-side secret for signing session tokens. Generate with:
#   openssl rand -base64 32
# Use a DIFFERENT value in production from local dev — leaking the dev
# secret would only compromise local sessions, but reusing it in prod
# means anyone with this file can forge prod sessions.
# BETTER_AUTH_SECRET=
#
# Public base URL the auth handlers live behind. Better Auth uses this
# to compute OAuth callback URLs and the session-cookie domain.
#
# IMPORTANT: must match (a) the port your `npm run dev` actually serves
# on, and (b) the Authorization callback URL registered on your GitHub
# OAuth App. Mismatch produces "Invalid origin" (CSRF guard) or GitHub
# redirecting back to the wrong port after sign-in.
#
# Local dev: http://localhost:3001 (or 3000 — whichever your dev server uses)
# Production: https://codetrawl.com (or whatever your prod URL is)
# BETTER_AUTH_URL=http://localhost:3001
#
# GitHub OAuth login credentials. Register at
#   https://github.com/settings/developers → "New OAuth App"
# (NOT a GitHub App — those are above for PR-bot installations.)
# Authorization callback URL:
#   http://localhost:3000/api/auth/callback/github (dev)
#   https://codetrawl.com/api/auth/callback/github (prod)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Email sender (Resend, v0.76+) ---
# Powers email verification + password reset. Sign up at
#   https://resend.com  →  API Keys  →  Create
# Free tier: 3000 emails/mo, 100/day — plenty for early beta.
#
# Without a verified domain, Resend restricts sender to
# `onboarding@resend.dev` and recipient to your Resend-account email.
# Fine for local dev; for production verify codetrawl.com on Resend's
# dashboard and set EMAIL_FROM below.
# RESEND_API_KEY=
#
# Optional override for the From-address. Defaults to
#   CodeTrawl <onboarding@resend.dev>
# Once you've verified a domain (Phase D4), set this to
#   CodeTrawl <noreply@codetrawl.com>
# EMAIL_FROM=

# --- Billing (Polar.sh, v0.78+) ---
# Powers pricing tier upgrades + subscription lifecycle. Sign up at
#   https://polar.sh  →  API Keys
# Polar is Merchant of Record — handles VAT, sales tax, payment
# processing, customer portal, refunds. We just create checkout
# sessions + listen for webhook events.
#
# Required:
# POLAR_API_KEY=polar_pat_...
#
# Webhook secret from the endpoint config in Polar dashboard:
#   https://polar.sh  →  Settings  →  Webhooks  →  Add endpoint
#     URL: https://codetrawl.com/api/polar/webhook
#     Events: subscription.created, subscription.updated,
#             subscription.canceled, subscription.revoked,
#             subscription.active
# POLAR_WEBHOOK_SECRET=whsec_...
#
# Environment selector. Defaults to "production" if unset. Set to
# "sandbox" for testing against Polar's sandbox environment.
# POLAR_SERVER=production
