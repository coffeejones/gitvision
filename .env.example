# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real tokens.

# GitHub API token. Without one, the unauthenticated rate limit (60
# req/hr) makes most analyses fail. With one, you get 5000 req/hr.
# Generate at https://github.com/settings/tokens/new — tick `public_repo`
# scope only. Read-only is plenty.
GITHUB_TOKEN=

# Optional — enables the AI summary + AI health verdict panels.
# Get a key at https://console.anthropic.com/settings/keys
# Leave empty to disable AI features (the panels just hide themselves
# gracefully — every other tab still works).
ANTHROPIC_API_KEY=

# Optional — daily kill-switch on Anthropic API calls (v0.36+).
# Resets at UTC midnight. Default 100 if unset. Set to 0 as a panic
# switch (disables AI globally). Useful when running publicly to bound
# the worst-case Anthropic bill.
# AI_DAILY_BUDGET=100

# Optional — Plausible analytics domain (v0.41+). When set, the
# Plausible script loads on every page; cookie-free, IP-anonymized.
# Unset → no analytics, no script tag, no tracking.
# Set to your Plausible domain (e.g. gitvision.app) — this must match
# the domain you registered in your Plausible dashboard.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Optional — feedback URL for the footer "Feedback" link (v0.41+).
# Point to a Tally / Cal.com / Typeform URL. Falls back to the GitHub
# Issues page when unset.
# NEXT_PUBLIC_FEEDBACK_URL=

# Optional — persistent volume directory on Railway. Sessions and
# job-status files live under <DATA_DIR>/sessions and <DATA_DIR>/jobs.
# Default: .gitvision/ in the project root (good for local dev).
# GITVISION_DATA_DIR=/data

# --- GitHub App (PR-bot) ---
# These are only required if you're running the GitHub App webhook
# receiver. The web UI works fine without them. See
# eval/strategy/github-app-skeleton-2026-05.md for the full design.
#
# App ID from https://github.com/settings/apps/<your-app>
# GITHUB_APP_ID=
#
# RSA private key for signing JWTs to GitHub. Base64-encode the PEM
# blob so it fits in a single env var without multi-line escaping:
#   base64 -i path/to/private-key.pem | pbcopy
# Then decode at runtime in lib/githubApp/auth.ts.
# GITHUB_APP_PRIVATE_KEY=
#
# Webhook secret — strong random string set when registering the app.
# Used by /api/github/webhook to verify HMAC-SHA256 signatures.
# Required for the webhook receiver to accept any request (returns 503
# otherwise).
# GITHUB_APP_WEBHOOK_SECRET=
#
# OAuth client ID (only needed for install-redirect URL in Commit 8+).
# GITHUB_APP_CLIENT_ID=
#
# Public base URL of the GitVision workspace — used to build the
# "Full analysis ↗" link in PR comments. No trailing slash.
# Production: https://gitvision.net
# Local dev: defaults to http://localhost:3000 when unset.
# GITVISION_PUBLIC_URL=
