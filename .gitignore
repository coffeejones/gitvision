# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# MCP server build output (regenerated via `npm run mcp:build`)
/mcp/dist/

# GitVision user data (sessions are per-machine, regeneratable)
/.gitvision/

# Scratch space for local test uploads — never committed
/demo-project/

# Claude Code local prefs (keep launch.json tracked for team DX)
.claude/settings.local.json

# Behind-the-scenes docs — kept locally for AI-assistant onboarding
# and launch-strategy drafting, but not part of the public repo.
# (Accessible in git history of older commits; not destructively rewritten.)
/CLAUDE.md
/AGENTS.md
/doc/launch/
/doc/future/

# codetrawl-mcp package build artifact
mcp/pkg/

# benchmark harness working dir (clones + results)
scripts/benchmark/.work/
